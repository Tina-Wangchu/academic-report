# =============================================================================
# Academic Report 配置文件（.env.example）
# =============================================================================
# 使用方法：
#   cp .env.example .env   然后在 .env 中填入你自己的值。
#   .env 是本工程【唯一】的配置来源，不被 git 跟踪；本文件是模板，会被跟踪。
#
# 加载优先级（高 → 低）：真实环境变量 > .env 文件 > 代码默认值
#   （所以也可临时用 `export KEY=VAL` 覆盖，无需改 .env）
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 邮件配置（必需 —— 报告作为附件通过 SMTP 发送）
# -----------------------------------------------------------------------------
# 常见主机：Gmail=smtp.gmail.com / Outlook=smtp-mail.outlook.com / QQ=smtp.qq.com
SMTP_HOST=smtp.gmail.com
# 端口：TLS=587，SSL=465
SMTP_PORT=587
# 发件邮箱（通常即登录用户名）
SMTP_USER=your-email@gmail.com
# 密码：Gmail 请用「应用专用密码」https://myaccount.google.com/apppasswords
#       QQ 邮箱请用「授权码」（非 QQ 登录密码）
SMTP_PASSWORD=your-app-password

# 默认收件人；留空则回退到 SMTP_USER（即发给自己）
EMAIL_RECIPIENT=

# -----------------------------------------------------------------------------
# 2. LLM 配置（推荐 —— 用于四要素深度分析）
# -----------------------------------------------------------------------------
# 未配置或调用失败时，自动回退到规则抽取，绝不崩溃、绝不编造。
# 默认走智谱 GLM 的 Anthropic 兼容端点（零额外 SDK 依赖）。
LLM_ENABLED=true
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://open.bigmodel.cn/api/anthropic
LLM_PROVIDER=zhipu
# 模型名（不设则用代码默认；智谱 BigModel 常见如 glm-4.5-turbo）
# LLM_MODEL=glm-4.5-turbo

# -----------------------------------------------------------------------------
# 3. 学术搜索 API 密钥（可选 —— 提升配额 / 速率）
# -----------------------------------------------------------------------------
# Semantic Scholar：无 key 时走共享公共配额，极易 429 限流（返回 0 篇）。
# 强烈建议申请：https://www.semanticscholar.org/product/api#api-key
SEMANTIC_SCHOLAR_API_KEY=
# （arXiv / OpenAlex 无需 key）

# -----------------------------------------------------------------------------
# 4. 报告与投递参数（脚本不再自带硬编码默认 —— 这些值即脚本的默认行为）
# -----------------------------------------------------------------------------
# 输出语言：en / zh / bilingual
DEFAULT_LANGUAGE=bilingual
# 默认时间范围：支持 3y / 1y / 1w / 近3年 / all
DEFAULT_TIME_RANGE=3y
# 每个数据源最大结果数
MAX_RESULTS=50
# 兜底查询主题（用户输入未识别出主题时使用）
DEFAULT_QUERY=人工智能
# 报告附件格式：pdf（默认，邮件附件为 PDF）/ markdown（附件为 .md）；.md 始终落盘作源
OUTPUT_FORMAT=pdf
# 报告保存目录（相对当前工作目录）
OUTPUT_DIR=reports
# 是否默认发送邮件（命令行 --no-email 可临时关闭本次发送）
SEND_EMAIL=true
# 是否包含预印本（arXiv 等）
INCLUDE_PREPRINTS=true
# 最小引用量筛选阈值（0 即不过滤）
MIN_CITATION_COUNT=0
# 高被引筛选开关与阈值
FILTER_HIGHLY_CITED=false
HIGHLY_CITED_THRESHOLD=100
# 是否仅保留 SCI/EI 期刊
SCI_EI_ONLY=false

# -----------------------------------------------------------------------------
# 5. 代理设置（可选 —— 仅当邮件发送被墙时，如国内直连 Gmail）
# -----------------------------------------------------------------------------
# email_sender 会按序自动尝试：直连 → 环境变量代理 → 本机 SOCKS 端口探测
# 国内 QQ/163 等邮箱直连即可，无需配置此处。
# 仅在需要显式指定代理时取消注释：
# SMTP_SOCKS_PROXY=socks5://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
