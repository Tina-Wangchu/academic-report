# Hermes Agent Academic Scholar Environment Variables Example
# 复制此文件到 ~/.hermes/.env 或手动设置环境变量

# ===================
# 邮件配置 (必需)
# ===================

# SMTP 服务器主机名
# Gmail: smtp.gmail.com
# Outlook: smtp-mail.outlook.com
# QQ Mail: smtp.qq.com
SMTP_HOST=smtp.gmail.com

# SMTP 服务器端口
# TLS: 587, SSL: 465
SMTP_PORT=587

# SMTP 用户名（通常是你的邮箱地址）
SMTP_USER=your-email@gmail.com

# SMTP 密码或应用专用密码
# Gmail 用户请生成应用专用密码: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your-app-password

# ===================
# API 密钥 (可选)
# ===================

# arXiv API 密钥（可选，用于提高请求限制）
# 获取地址: https://arxiv.org/help/api
# ARXIV_API_KEY=your-arxiv-api-key

# Semantic Scholar API 密钥（可选）
# 获取地址: https://www.semanticscholar.org/product/api#api-key
# SEMANTIC_SCHOLAR_API_KEY=your-s2s-key

# ===================
# 高级配置 (可选)
# ===================

# 代理设置（如果需要）
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080

# 请求超时时间（秒）
# REQUEST_TIMEOUT=30

# 并发请求数
# MAX_CONCURRENT_REQUESTS=5
